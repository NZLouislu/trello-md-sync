# ====================================
# Trello API Configuration
# ====================================
# Get these from https://trello.com/app-key
TRELLO_KEY=your_trello_api_key
TRELLO_TOKEN=your_trello_token

# Target Trello board ID (found in board URL)
TRELLO_BOARD_ID=your_board_id_here

# ====================================
# Directory Configuration
# ====================================
# Base directory for markdown files
MD_INPUT_DIR=examples/md

# Output directory for processed markdown files
MD_OUTPUT_DIR=examples/items

# Root directory of the project (auto-detected if empty)
PROJECT_ROOT=

# ====================================
# Trello List Mapping
# ====================================
# Map workflow states to Trello list names
TRELLO_LIST_MAP_JSON={"backlog":"Backlog","ready":"Ready","doing":"In Progress","review":"Review","done":"Done"}

# ====================================
# Checklist Configuration
# ====================================
# Name for the default checklist in Trello cards
CHECKLIST_NAME=Todos

# ====================================
# Label Configuration
# ====================================
# Automatically create missing labels in Trello
MDSYNC_ENSURE_LABELS=1

# Comma-separated list of required labels
REQUIRED_LABELS=sync,trello,parser,provider,importer,exporter,tests,ci,docs,cli,examples

# Map priority shortcuts to full label names
PRIORITY_LABEL_MAP_JSON={"p1":"Priority: High","p2":"Priority: Medium","p3":"Priority: Low"}

# Map label tokens to actual Trello label names
LABEL_TOKEN_MAP_JSON={"bug":"Type: Bug", "feat":"Type: Feature", "chore":"Type: Chore"}

# ====================================
# Member Configuration
# ====================================
# Map team member aliases to Trello usernames
MEMBER_ALIAS_MAP_JSON={"backend":"dev1_username","frontend":"dev2_username","qa":"qa_username","devops":"devops_username"}

# ====================================
# Filtering Options
# ====================================
# Filter cards by list name (exact match)
TRELLO_FILTER_LIST=

# Filter cards by label (exact match)
TRELLO_FILTER_LABEL=

# Filter by specific story ID
TRELLO_FILTER_STORYID=

# ====================================
# Logging & Debugging
# ====================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Output logs as JSON (1) or plain text (0)
LOG_JSON=0

# Enable verbose output (1) or not (0)
VERBOSE=0

# ====================================
# Runtime Behavior
# ====================================
# Dry run mode - don't make any changes (1) or allow changes (0)
MDSYNC_DRY_RUN=0

# Strict status checking - fail if status doesn't match (1) or continue with warning (0)
MDSYNC_STRICT_STATUS=0

# Write changes back to local markdown files (1) or not (0)
MDSYNC_WRITE_LOCAL=0